# Conexão com o PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cardiopredict

# Conexão com o Redis (opcional, fallback para cache em memória se indisponível)
REDIS_URL=redis://localhost:6379

# Origens permitidas para CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://seu-front.vercel.app
